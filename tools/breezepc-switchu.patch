+
+    def send_switchu_launch(self, path):
+        if self.switchu_busy:
+            self.status.config(text="A SwitchU request is already pending; no second launch was sent.")
+            return
+        self.switchu_busy = True
+        self._set_switchu_buttons()
+        generation = self.switchu_generation
+        host, code = self.cfg["host"], self.cfg["code"]
+        self.status.config(text="Sending one launch request to SwitchU...")
+        threading.Thread(target=self._switchu_launch_worker,
+                         args=(generation, host, code, path), daemon=True).start()
+
+    def _set_switchu_buttons(self):
+        state = "disabled" if self.switchu_busy else "normal"
+        self.switchu_breeze_btn.config(state=state)
+        self.switchu_nro_btn.config(state=state)
+        self.switchu_status_btn.config(state=state)
+        self.switchu_controller_btn.config(state=state)
+        for button in self.switchu_input_buttons:
+            button.config(state=state)
+        for canvas in getattr(self, "switchu_input_canvases", ()):
+            canvas.config(state=state)
+
+    def _switchu_launch_worker(self, generation, host, code, path):
+        try:
+            receipt = switchu_remote.launch(host, code, path, timeout=3.0)
+        except switchu_remote.AmbiguousLaunchError as exc:
+            self.out.put(("switchu_remote", generation, True,
+                          "Launch result unknown: %s. Check SwitchU status; it was not resent." % exc))
+            return
+        except (switchu_remote.RemoteError, ValueError) as exc:
+            self.out.put(("switchu_remote", generation, True, "SwitchU launch failed: %s" % exc))
+            return
+
+        number = switchu_remote.request_id(receipt)
+        if number is None:
+            self.out.put(("switchu_remote", generation, True,
+                          "SwitchU accepted the request: %s (loader state not reported)." % receipt))
+            return
+        self.out.put(("switchu_remote", generation, False,
+                      "SwitchU queued request %d for %s; checking loader status..." % (number, path)))
+        try:
+            observed = switchu_remote.wait_for_request(host, code, number, timeout=2.0,
+                                                       deadline=12.0, interval=0.75)
+            observed_id = switchu_remote.request_id(observed)
+            state = switchu_remote.status_state(observed)
+            if observed_id is not None and observed_id > number:
+                message = ("SwitchU request %d was superseded by newer request %d; it was not resent. "
+                           "Current status: %s" % (number, observed_id, observed))
+            elif state == "started":
+                message = ("SwitchU loader started request %d; the requested NRO reaching its own "
+                           "startup is not confirmed." % number)
+            elif state == "failed":
+                message = "SwitchU loader failed request %d: %s" % (number, observed)
+            elif state == "finished":
+                message = ("SwitchU loader finished request %d; the requested NRO reaching its own "
+                           "startup is not confirmed. %s" % (number, observed))
+            else:
+                message = "SwitchU queued request %d; latest daemon status: %s" % (number, observed)
+        except switchu_remote.RemoteError as exc:
+            message = ("SwitchU queued request %d; status check failed: %s. The launch was not resent." %
+                       (number, exc))
+        self.out.put(("switchu_remote", generation, True, message))
+
+    def _switchu_status_worker(self, generation, host, code):
+        try:
+            reply = switchu_remote.status(host, code, timeout=3.0)
+            message = "SwitchU: " + reply
+        except switchu_remote.RemoteError as exc:
+            message = "SwitchU status unavailable: %s" % exc
+        self.out.put(("switchu_remote", generation, True, message))
 
