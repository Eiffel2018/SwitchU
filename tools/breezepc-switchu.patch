+
+    def _switchu_input_worker(self, generation, host, code, button):
+        try:
+            reply = switchu_remote.press_button(host, code, button, 100, timeout=3.0)
+            message = ("SwitchU accepted %s for 100 ms; this does not confirm the NRO responded." % button)
+        except switchu_remote.AmbiguousInputError as exc:
+            message = ("Button result unknown: %s. It was not resent." % exc)
+        except (switchu_remote.RemoteError, ValueError) as exc:
+            message = "SwitchU button press failed: %s" % exc
+        self.out.put(("switchu_remote", generation, True, message))
+
+    def _switchu_stick_worker(self, generation, host, code, side, x, y):
+        try:
+            switchu_remote.stick(host, code, side, x, y, 100, timeout=3.0)
+            message = ("SwitchU accepted one %s stick pulse (x=%d, y=%d) for 100 ms; it returns to center automatically." %
+                       (side, x, y))
+        except switchu_remote.AmbiguousInputError as exc:
+            message = ("Stick result unknown: %s. It was not resent." % exc)
+        except (switchu_remote.RemoteError, ValueError) as exc:
+            message = "SwitchU stick pulse failed: %s" % exc
+        self.out.put(("switchu_remote", generation, True, message))
+
+    def check_switchu_status(self):
+        if self.switchu_busy:
+            return
+        self.switchu_busy = True
+        self._set_switchu_buttons()
+        generation = self.switchu_generation
+        self.status.config(text="Checking SwitchU remote channel...")
+        threading.Thread(target=self._switchu_status_worker,
