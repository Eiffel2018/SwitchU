+    def _add_switchu_button(self, parent, label, key):
+        button = tk.Button(parent, text=label, width=5,
+                           command=lambda name=key: self.send_switchu_button(name))
+        self.switchu_input_buttons.append(button)
+        return button
+
+    def _place_switchu_button(self, canvas, label, key, x, y, width=58):
+        button = self._add_switchu_button(canvas, label, key)
+        canvas.create_window(x, y, window=button, width=width, height=30)
+        return button
+
+    def _place_switchu_stick_pad(self, parent, side, x, y):
+        color = "#d7f5f6" if side == "L" else "#ffe0dd"
+        pad = tk.Canvas(parent, width=118, height=118, background=color,
+                        highlightthickness=2, highlightbackground="#455568")
+        pad.create_oval(10, 10, 108, 108, outline="#526174", width=2, tags=("pad",))
+        pad.create_line(59, 18, 59, 100, fill="#9aa7b5", tags=("axis",))
+        pad.create_line(18, 59, 100, 59, fill="#9aa7b5", tags=("axis",))
+        for px, py, arrow in ((59, 23, "↑"), (95, 59, "→"),
+                              (59, 95, "↓"), (23, 59, "←")):
+            pad.create_text(px, py, text=arrow, fill="#354454", font=("Segoe UI", 9), tags=("direction",))
+        pad.create_oval(42, 42, 76, 76, fill="#c8d0da", outline="#526174", tags=("center",))
+        pad.create_text(59, 59, text=side + "3", fill="#1e2936", tags=("center-label",))
+        parent.create_window(x, y, window=pad)
+
+        def click(event):
+            dx, dy = event.x - 59, 59 - event.y
+            radius = max(1, min(47, int((dx * dx + dy * dy) ** 0.5)))
+            if radius <= 13:
+                self.send_switchu_button("LSTICK" if side == "L" else "RSTICK")
+                return
+            x = max(-32768, min(32767, round(dx * 32767 / radius)))
+            y = max(-32768, min(32767, round(dy * 32767 / radius)))
+            self.send_switchu_stick(side, x, y)
+
+        pad.bind("<Button-1>", click)
+        self.switchu_input_canvases.append(pad)
+        return pad
