+            self.switchu_controller = None
+            self.switchu_input_buttons = []
+            self.switchu_input_canvases = []
+
+    def send_switchu_button(self, button):
+        if self.switchu_controller_state != "enabled" or self.switchu_controller_command_pending:
+            self.status.config(text="SwitchU input is disabled until the controller is explicitly enabled.")
+            return
+        if self.switchu_busy:
+            self.status.config(text="A SwitchU request is pending; no button press was sent.")
+            return
+        if self.switchu_waiting_for_pad or not self._switchu_pad_ready():
+            self.status.config(text="SwitchU input is blocked until Breeze Game input release is confirmed.")
+            return
+        self.switchu_busy = True
+        self._set_switchu_buttons()
+        generation = self.switchu_generation
+        host, code = self.cfg["host"], self.cfg["code"]
+        self.status.config(text="Sending one %s press (100 ms) to SwitchU..." % button)
+        threading.Thread(target=self._switchu_input_worker,
+                         args=(generation, host, code, button), daemon=True).start()
+
+    def send_switchu_stick(self, side, x, y):
+        if self.switchu_controller_state != "enabled" or self.switchu_controller_command_pending:
+            self.status.config(text="SwitchU input is disabled until the controller is explicitly enabled.")
+            return
+        if self.switchu_busy:
+            self.status.config(text="A SwitchU request is pending; no stick pulse was sent.")
+            return
+        if self.switchu_waiting_for_pad or not self._switchu_pad_ready():
+            self.status.config(text="SwitchU input is blocked until Breeze Game input release is confirmed.")
+            return
+        self.switchu_busy = True
+        self._set_switchu_buttons()
+        generation = self.switchu_generation
+        host, code = self.cfg["host"], self.cfg["code"]
+        self.status.config(text="Sending one %s stick pulse (x=%d, y=%d, 100 ms)..." % (side, x, y))
+        threading.Thread(target=self._switchu_stick_worker,
+                         args=(generation, host, code, side, x, y), daemon=True).start()
+
+    def _switchu_input_worker(self, generation, host, code, button):
+        try:
+            reply = switchu_remote.press_button(host, code, button, 100, timeout=3.0)
+            message = ("SwitchU accepted %s for 100 ms; this does not confirm the NRO responded." % button)
+        except switchu_remote.AmbiguousInputError as exc:
+            message = ("Button result unknown: %s. It was not resent." % exc)
+        except (switchu_remote.RemoteError, ValueError) as exc:
+            message = "SwitchU button press failed: %s" % exc
+        self.out.put(("switchu_remote", generation, True, message))
+
+    def _switchu_stick_worker(self, generation, host, code, side, x, y):
+        try:
+            switchu_remote.stick(host, code, side, x, y, 100, timeout=3.0)
+            message = ("SwitchU accepted one %s stick pulse (x=%d, y=%d) for 100 ms; it returns to center automatically." %
+                       (side, x, y))
+        except switchu_remote.AmbiguousInputError as exc:
+            message = ("Stick result unknown: %s. It was not resent." % exc)
+        except (switchu_remote.RemoteError, ValueError) as exc:
+            message = "SwitchU stick pulse failed: %s" % exc
+        self.out.put(("switchu_remote", generation, True, message))
+
+    def check_switchu_status(self):
+        if self.switchu_busy:
+            return
+        self.switchu_busy = True
+        self._set_switchu_buttons()
+        generation = self.switchu_generation
+        self.status.config(text="Checking SwitchU remote channel...")
+        threading.Thread(target=self._switchu_status_worker,
+                         args=(generation, self.cfg["host"], self.cfg["code"]), daemon=True).start()
+
+    def send_switchu_launch(self, path):
+        if self.switchu_busy:
+            self.status.config(text="A SwitchU request is already pending; no second launch was sent.")
+            return
+        self.switchu_busy = True
+        self._set_switchu_buttons()
+        generation = self.switchu_generation
+        host, code = self.cfg["host"], self.cfg["code"]
+        self.status.config(text="Sending one launch request to SwitchU...")
+        threading.Thread(target=self._switchu_launch_worker,
+                         args=(generation, host, code, path), daemon=True).start()
+
+    def _set_switchu_buttons(self):
+        handoff_blocked = (self.switchu_busy or self.switchu_waiting_for_pad
+                           or not self._switchu_pad_ready())
+        state = "disabled" if handoff_blocked else "normal"
+        self.switchu_breeze_btn.config(state=state)
+        self.switchu_nro_btn.config(state=state)
+        self.switchu_status_btn.config(state=state)
+        self.switchu_controller_btn.config(state=state)
+        input_blocked = (handoff_blocked or self.switchu_controller_state != "enabled"
+                         or self.switchu_controller_command_pending)
+        input_state = "disabled" if input_blocked else "normal"
+        for button in self.switchu_input_buttons:
+            button.config(state=input_state)
+        for canvas in getattr(self, "switchu_input_canvases", ()):
+            canvas.config(state=input_state)
+        command_pending = self.switchu_controller_command_pending
+        if self.switchu_stop_btn is not None:
+            self.switchu_stop_btn.config(state="disabled" if command_pending else "normal")
+        if self.switchu_resume_btn is not None:
+            can_resume = (self._switchu_popup_open() and self._switchu_pad_ready()
+                          and not self.switchu_waiting_for_pad and not command_pending
+                          and not self.switchu_busy
+                          and self.switchu_controller_state != "enabled")
+            self.switchu_resume_btn.config(state="normal" if can_resume else "disabled")
+
+    def _switchu_launch_worker(self, generation, host, code, path):
+        try:
+            receipt = switchu_remote.launch(host, code, path, timeout=3.0)
+        except switchu_remote.AmbiguousLaunchError as exc:
+            self.out.put(("switchu_remote", generation, True,
+                          "Launch result unknown: %s. Check SwitchU status; it was not resent." % exc))
+            return
+        except (switchu_remote.RemoteError, ValueError) as exc:
+            self.out.put(("switchu_remote", generation, True, "SwitchU launch failed: %s" % exc))
+            return
+
+        number = switchu_remote.request_id(receipt)
+        if number is None:
+            self.out.put(("switchu_remote", generation, True,
+                          "SwitchU accepted the request: %s (loader state not reported)." % receipt))
+            return
+        self.out.put(("switchu_remote", generation, False,
+                      "SwitchU queued request %d for %s; checking loader status..." % (number, path)))
+        try:
+            observed = switchu_remote.wait_for_request(host, code, number, timeout=2.0,
+                                                       deadline=12.0, interval=0.75)
+            observed_id = switchu_remote.request_id(observed)
+            state = switchu_remote.status_state(observed)
+            if observed_id is not None and observed_id > number:
+                message = ("SwitchU request %d was superseded by newer request %d; it was not resent. "
+                           "Current status: %s" % (number, observed_id, observed))
+            elif state == "started":
+                message = ("SwitchU loader started request %d; the requested NRO reaching its own "
+                           "startup is not confirmed." % number)
+            elif state == "failed":
+                message = "SwitchU loader failed request %d: %s" % (number, observed)
+            elif state == "finished":
+                message = ("SwitchU loader finished request %d; the requested NRO reaching its own "
+                           "startup is not confirmed. %s" % (number, observed))
+            else:
+                message = "SwitchU queued request %d; latest daemon status: %s" % (number, observed)
+        except switchu_remote.RemoteError as exc:
+            message = ("SwitchU queued request %d; status check failed: %s. The launch was not resent." %
+                       (number, exc))
+        self.out.put(("switchu_remote", generation, True, message))
+
+    def _switchu_status_worker(self, generation, host, code):
+        try:
+            reply = switchu_remote.status(host, code, timeout=3.0)
+            message = "SwitchU: " + reply
+        except switchu_remote.RemoteError as exc:
+            message = "SwitchU status unavailable: %s" % exc
+        self.out.put(("switchu_remote", generation, True, message))
